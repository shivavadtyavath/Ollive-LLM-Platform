# Copy this to .env and fill in your values

# Database (auto-configured in Docker)
DATABASE_URL=postgresql+asyncpg://ollive:ollive@db:5432/ollive
DATABASE_SYNC_URL=postgresql://ollive:ollive@db:5432/ollive

# Redis (auto-configured in Docker)
REDIS_URL=redis://redis:6379/0

# ── LLM Providers ──────────────────────────────────────────────────────────
# Pick at least one. Groq is recommended — free tier, very fast.

# Groq (FREE) — get key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama (FREE, LOCAL) — runs inside Docker, no key needed
OLLAMA_BASE_URL=http://ollama:11434

# OpenRouter (FREE models available) — https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenAI (paid) — optional
OPENAI_API_KEY=

# ── Defaults ────────────────────────────────────────────────────────────────
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama3-8b-8192

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
PII_REDACTION_ENABLED=true
MAX_CONTEXT_MESSAGES=20
